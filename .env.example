# Copy to .env and fill in. Every key the app reads is listed here; the
# values shown are the defaults or examples. .env itself is git-ignored.

# ---------------------------------------------------------------- market data
# Root of the merged engine-ready tree: <root>/<YYYY>/<MON_YYYY>/SENSEX_MERGED_FULL_DDMMYYYY.parquet
SENSEX_PROCESSED_FULL_PATH=/data/sensex/MergedFull
# Raw daily trees -- only scripts/preprocess_sensex.py needs these
# SENSEX_SPOT_PATH=/data/sensex/Spot
# SENSEX_FNO_PATH=/data/sensex/FNO
# Preload at startup: everything on disk (default) or a range for small machines
# DATA_PRELOAD=true
# DATA_PRELOAD_RANGE=2026-01-01:2026-01-30

# ---------------------------------------------------------------- CPU workers
# Forked worker processes for single backtests (0 = half the cores)
BACKTEST_WORKERS=8
# Cap on a portfolio run's own worker pool (0 = all cores)
PORTFOLIO_MAX_WORKERS=16

# ---------------------------------------------------------------- database
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=strategy_builder
DATABASE_USER=strategy_app
DATABASE_PASSWORD=change-me
# Connection pool: MIN kept warm, MAX burst cap (< PostgreSQL max_connections), WAIT seconds for a free one
DB_POOL_MIN=10
DB_POOL_MAX=20
DB_POOL_WAIT_SECONDS=10

# ---------------------------------------------------------------- auth
# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me
JWT_EXPIRES_HOURS=168
# true echoes the one-time code in API responses -- testing only, never in production
OTP_DEV_MODE=false
# console (code goes to the server log) | email (SMTP below)
OTP_PROVIDER=email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASSWORD=16-char-gmail-app-password
# SMTP_FROM=yourapp@gmail.com          # defaults to SMTP_USER
SMTP_FROM_NAME=Strategy Builder
# Google sign-in: OAuth Web client id; the /auth/google route returns 501 until set
# GOOGLE_CLIENT_ID=

# ---------------------------------------------------------------- web
# Comma-separated browser origins allowed to call the API (default * for local dev)
CORS_ORIGINS=https://app.yourdomain.com